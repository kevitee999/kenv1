end)

local SpeedValBtn = createButton("Speed Value: " .. tostring(speedBoost) .. "x")
SpeedValBtn.TextColor3 = Color3.fromRGB(0, 217, 255)
SpeedValBtn.MouseButton1Click:Connect(function()
	currentSpeedIdx = (currentSpeedIdx % #speedMultipliers) + 1
	speedBoost = speedMultipliers[currentSpeedIdx]
	SpeedValBtn.Text = "Speed Value: " .. tostring(speedBoost) .. "x"
end)
