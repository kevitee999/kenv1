-- ==========================
-- 3. ENVIRONMENT NOCLIP (Rocks, Tiki, Enemies)
-- ==========================
local function disableCollision(parentInstance)
    if not parentInstance then return end
    for _, obj in ipairs(parentInstance:GetDescendants()) do
        if obj:IsA("BasePart") then
            if originalCollisionStates[obj] == nil then 
                originalCollisionStates[obj] = obj.CanCollide 
            end
            if obj.CanCollide then 
                obj.CanCollide = false 
            end
        end
    end
end

local function restoreCollisions()
    for obj, originalState in pairs(originalCollisionStates) do
        if obj and obj.Parent then 
            obj.CanCollide = originalState 
        end
    end
    table.clear(originalCollisionStates)
end

RunService.Stepped:Connect(function()
    if not noclipEnabled then return end
    disableCollision(workspace:FindFirstChild("Rocks"))
    local mapFolder = workspace:FindFirstChild("Map")
    if mapFolder then 
        disableCollision(mapFolder:FindFirstChild("TikiOutpost"))
        disableCollision(mapFolder:FindFirstChild("ShipwreckIsland"))
    end
    disableCollision(workspace:FindFirstChild("Enemies"))
end)

