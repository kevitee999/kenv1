-- ==========================
-- 4. BOAT SPEED & MULTIPLIER
-- ==========================
RunService.Heartbeat:Connect(function()
	if not speedEnabled then return end
	local char = LocalPlayer.Character
	if not char then return end

	local humanoid = char:FindFirstChild("Humanoid")
	if humanoid and humanoid.SeatPart then
		local seat = humanoid.SeatPart
		if seat:IsDescendantOf(workspace:FindFirstChild("Boats") or workspace) then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				local boatModel = seat:FindFirstAncestorWhichIsA("Model")
				local rootPart = boatModel and boatModel.PrimaryPart or seat
				rootPart.CFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * speedBoost)
			end
		end
	end
end)

