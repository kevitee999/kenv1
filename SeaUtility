-- ==========================
-- 5 & 6. BOAT SPEED & AUTO SEAT
-- ==========================
local lastSeatCheck = 0

RunService.Heartbeat:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChild("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    
    if humanoid and rootPart then
        -- 1. Auto Seat Logic
        if autoSeatEnabled and not humanoid.SeatPart then
            local now = tick()
            if now - lastSeatCheck >= 0.25 then 
                lastSeatCheck = now
                local closestSeat = nil
                local shortestDistance = 150 
                
                for _, obj in ipairs(boatsFolder:GetDescendants()) do
                    if (obj:IsA("VehicleSeat") or obj:IsA("Seat")) and not obj.Occupant then
                        local dist = (rootPart.Position - obj.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestSeat = obj
                        end
                    end
                end
                
                if closestSeat then
                    closestSeat:Sit(humanoid)
                    
                    -- FIX: Re-trigger Auto W automatically once seated
                    if autoWEnabled then
                        task.spawn(function()
                            task.wait(0.2) -- Brief delay to allow the character to fully attach to the seat
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game) -- Release W
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)  -- Re-press W
                        end)
                    end
                end
            end
        end

        -- 2. Boat Speed Forward Logic
        if humanoid.SeatPart then
            local seat = humanoid.SeatPart
            local inBoat = seat:IsDescendantOf(workspace:FindFirstChild("Boats") or workspace)
            
            if inBoat then
                local boatModel = seat:FindFirstAncestorWhichIsA("Model")
                local boatRoot = boatModel and boatModel.PrimaryPart or seat
                local moveVector = Vector3.zero

                if speedEnabled and (UserInputService:IsKeyDown(Enum.KeyCode.W) or autoWEnabled) then
                    moveVector = moveVector + (boatRoot.CFrame.LookVector * (speedBoost * deltaTime * 60))
                end

                if moveVector ~= Vector3.zero then
                    boatRoot.CFrame = boatRoot.CFrame + moveVector
                    
                    if speedEnabled then
                        boatRoot.AssemblyLinearVelocity = Vector3.new(0, boatRoot.AssemblyLinearVelocity.Y, 0)
                        boatRoot.AssemblyAngularVelocity = Vector3.new(0, boatRoot.AssemblyAngularVelocity.Y, 0)
                    end
                end
            end
        end
    end
end)

