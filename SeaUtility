end

-- ==========================
-- 1. BOAT ESP SYSTEM
-- ==========================
local function createBoatESP(boat)
	if not boat:IsA("Model") or espObjects[boat] then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "BoatESP_Highlight"
	highlight.FillColor = Color3.fromRGB(0, 217, 255)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Adornee = boat
	highlight.Enabled = espEnabled
	highlight.Parent = boat

	local primaryPart = boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart")
	if not primaryPart then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "BoatESP_Billboard"
	billboard.Adornee = primaryPart
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = espEnabled
	billboard.Parent = boat

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
	textLabel.TextStrokeTransparency = 0
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.TextSize = 12
	textLabel.Font = Enum.Font.SourceSansBold
	textLabel.Text = "🚤 " .. boat.Name
	textLabel.Parent = billboard

	local connection = RunService.Heartbeat:Connect(function()
		if not boat or not boat.Parent or not primaryPart or not primaryPart.Parent then return end
		if espEnabled then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local distance = math.floor((char.HumanoidRootPart.Position - primaryPart.Position).Magnitude)
				textLabel.Text = string.format("🚤 %s\n[%d m]", boat.Name, distance)
			end
		end
	end)

	espObjects[boat] = { Highlight = highlight, Billboard = billboard, Connection = connection }
end

local function removeBoatESP(boat)
	if espObjects[boat] then
		if espObjects[boat].Connection then espObjects[boat].Connection:Disconnect() end
		if espObjects[boat].Highlight then espObjects[boat].Highlight:Destroy() end
		if espObjects[boat].Billboard then espObjects[boat].Billboard:Destroy() end
		espObjects[boat] = nil
	end
end

for _, boat in ipairs(boatsFolder:GetChildren()) do createBoatESP(boat) end
boatsFolder.ChildAdded:Connect(function(boat) task.wait(0.2) createBoatESP(boat) end)
boatsFolder.ChildRemoved:Connect(removeBoatESP)

local EspBtn = createButton("Boat ESP: OFF")
EspBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	EspBtn.Text = "Boat ESP: " .. (espEnabled and "ON" or "OFF")
	EspBtn.TextColor3 = espEnabled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(200, 200, 200)
	for _, esp in pairs(espObjects) do
		if esp.Highlight then esp.Highlight.Enabled = espEnabled end
		if esp.Billboard then esp.Billboard.Enabled = espEnabled end
	end
end)

-- ==========================
-- 2. ROCK & TIKI NOCLIP SYSTEM
-- ==========================
local function disableCollision(parentInstance)
	if not parentInstance then return end
	for _, obj in ipairs(parentInstance:GetDescendants()) do
		if obj:IsA("BasePart") and obj.CanCollide then
			obj.CanCollide = false
		end
	end
end

RunService.Stepped:Connect(function()
	if not noclipEnabled then return end
	disableCollision(workspace:FindFirstChild("Rocks"))
	local mapFolder = workspace:FindFirstChild("Map")
	if mapFolder then disableCollision(mapFolder:FindFirstChild("TikiOutpost")) end
end)

