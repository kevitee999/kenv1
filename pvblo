	if myHRP then
		if not att0 or not att0.Parent then
			att0 = Instance.new("Attachment")
			att0.Name = "SA_Att0"
			att0.Parent = myHRP
		end
		if not att1 or not att1.Parent then
			att1 = Instance.new("Attachment")
			att1.Name = "SA_Att1"
			att1.Parent = aimRoot
		else
			att1.Parent = aimRoot
