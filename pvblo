-- MousePos / silent aim (players + NPC)
task.spawn(function()
	while wait() do
		pcall(function()
			if not silentAimEnabled or not _G.AimMethod then return end

			if npcModeEnabled then
				if not currentNpc or not isValidEnemy(currentNpc) then
					currentNpc = getNearestEnemy(500)
				end
				if currentNpc then
					local root = getEnemyRoot(currentNpc)
					if root then
						MousePos = root.Position
						return
					end
				end
			end

			if currentTarget and isValidTarget(currentTarget) then
				MousePos = currentTarget.Character.HumanoidRootPart.Position
				return
			end
			if ABmethod == "Nearest Aim" and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				local MaxDistance = math.huge
				for _, v in pairs(Players:GetPlayers()) do
					if isValidTarget(v) then
						local Distance = (v.Character.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
						if Distance < MaxDistance then
							MaxDistance = Distance
							MousePos = v.Character.HumanoidRootPart.Position
						end
					end
				end
			end
		end)
	end
