-- Name ESP
local function clearNameEsp()
	for v, guiObj in pairs(nameEspGuis) do
		if guiObj then pcall(function() guiObj:Destroy() end) end
	end
	nameEspGuis = {}
end

local function updateNameEsp()
	if not nameEspEnabled then
		clearNameEsp()
		return
	end
	local myChar = getChar()
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local activePlayers = {}
	for _, v in ipairs(Players:GetPlayers()) do
		if v ~= plr and v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChild("HumanoidRootPart") then
			local hum = v.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and myHRP then
				local tHRP = v.Character.HumanoidRootPart
				local dist = (tHRP.Position - myHRP.Position).Magnitude
				if dist <= 600 then
					activePlayers[v] = true
					local espGui = nameEspGuis[v]
					if not espGui or not espGui.Parent then
						espGui = Instance.new("BillboardGui")
						espGui.Name = "NameESP"
						espGui.Size = UDim2.new(0, 160, 0, 40)
						espGui.StudsOffset = Vector3.new(0, 2.5, 0)
						espGui.AlwaysOnTop = true
						local txt = Instance.new("TextLabel")
						txt.Name = "Text"
						txt.Size = UDim2.new(1, 0, 1, 0)
						txt.BackgroundTransparency = 1
						txt.Font = Enum.Font.GothamBold
						txt.TextSize = 13
						txt.TextColor3 = Color3.fromRGB(255, 50, 50)
						txt.TextStrokeTransparency = 0.5
						txt.Parent = espGui
						espGui.Adornee = v.Character.Head
						espGui.Parent = v.Character
						nameEspGuis[v] = espGui
					end
					local txt = espGui:FindFirstChild("Text")
					if txt then txt.Text = v.DisplayName end
				else
					if nameEspGuis[v] then nameEspGuis[v]:Destroy() nameEspGuis[v] = nil end
				end
			else
				if nameEspGuis[v] then nameEspGuis[v]:Destroy() nameEspGuis[v] = nil end
			end
		else
			if nameEspGuis[v] then nameEspGuis[v]:Destroy() nameEspGuis[v] = nil end
		end
	end
	for v, guiObj in pairs(nameEspGuis) do
		if not v.Parent or not activePlayers[v] then
			if guiObj then guiObj:Destroy() end
			nameEspGuis[v] = nil
		end
	end
end

-- Namecall
local gg = getrawmetatable(game)
local old = gg.__namecall
setreadonly(gg, false)
gg.__namecall = newcclosure(function(...)
	local method = getnamecallmethod()
	local args = { ... }
	if tostring(method) == "FireServer" then
		if soruEnabled and tostring(args[2]) == "Soru" then
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local endCF = getTargetEndCF(hrp)
			if endCF then
				args[4] = endCF
				task.defer(function()
					pcall(function() if hrp then hrp.CFrame = endCF end end)
				end)
				task.delay(0.05, function()
					pcall(function() if hrp and hrp.Parent then hrp.CFrame = endCF end end)
				end)
				return old(unpack(args))
			else
				return
			end
		end
		if tostring(args[1]) == "RemoteEvent" then
			if tostring(args[2]) ~= "true" and tostring(args[2]) ~= "false" then
				if silentAimEnabled and (
					(_G.AimMethod and ABmethod == "Aim Player")
					or (_G.AimMethod and ABmethod == "Nearest Aim")
				) then
					args[2] = MousePos
					return old(unpack(args))
				end
			end
		end
	end
	return old(...)
end)
setreadonly(gg, true)

