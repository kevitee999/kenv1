local function doSoruToTarget()
	if not soruEnabled then return end
	if tick() - lastSoru < SORU_CD then return end
	local char = getChar()
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	if not currentTarget or not isValidTarget(currentTarget) then
		print("[Soru] No target — press B first")
		return
	end
	local tHRP = currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")
	if tHRP and (tHRP.Position - hrp.Position).Magnitude > MAX_SORU_DIST then
		notify("Target too far for Soru! (>750 studs)")
		return
	end
	local startCF = hrp.CFrame
	local endCF = getTargetEndCF(hrp)
	if not endCF then return end
	pcall(function()
		ReplicatedStorage.Remotes.CommE:FireServer("Soru", startCF, endCF, workspace:GetServerTimeNow(), math.random(1, 999999999))
	end)
	pcall(function() hrp.CFrame = endCF end)
	task.delay(0.03, forceToTarget)
	task.delay(0.08, forceToTarget)
	lastSoru = tick()
	print("[Soru] →", currentTarget.Name)
end

local function applyAntiStun()
	if not antiStunEnabled then return end
	local char = getChar()
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then return end

	local stun = char:FindFirstChild("Stun") or hrp:FindFirstChild("Stun")
	if stun and (stun:IsA("NumberValue") or stun:IsA("IntValue")) and stun.Value ~= 0 then
		stun.Value = 0
	end

	local stunObjects = hrp:FindFirstChild("StunObjects") or char:FindFirstChild("StunObjects")
	if stunObjects then
		for _, obj in ipairs(stunObjects:GetChildren()) do
			pcall(function() obj:Destroy() end)
		end
	end

	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BodyVelocity") or obj:IsA("BodyPosition") or obj:IsA("BodyAngularVelocity")
			or obj:IsA("LinearVelocity") or obj:IsA("AlignPosition") then
			if obj:IsA("BodyVelocity") then
				if obj.Velocity.Magnitude < 4 and obj.MaxForce.Magnitude > 500 then
					pcall(function() obj:Destroy() end)
				end
			elseif obj:IsA("BodyPosition") or obj:IsA("AlignPosition") then
				pcall(function() obj:Destroy() end)
			elseif obj:IsA("BodyAngularVelocity") and obj.AngularVelocity.Magnitude < 1 then
				pcall(function() obj:Destroy() end)
			end
		end
	end

	pcall(function()
		for _, inst in ipairs({ char, hum, hrp }) do
			for attr, val in pairs(inst:GetAttributes()) do
				local n = string.lower(tostring(attr))
				if n:find("stun") or n:find("busy") or n:find("freeze") or n:find("lock")
					or n:find("disable") or n:find("nomove") or n:find("negative")
					or n:find("combo") or n:find("action") or n:find("using") then
					if typeof(val) == "boolean" then
						inst:SetAttribute(attr, false)
					elseif typeof(val) == "number" then
						inst:SetAttribute(attr, 0)
					end
				end
				if n == "canmove" or n == "canwalk" then
					inst:SetAttribute(attr, true)
				end
			end
		end
	end)

	hrp.Anchored = false
	hum.PlatformStand = false
	hum.Sit = false
	hum.AutoRotate = true
	if hum.WalkSpeed < 12 then hum.WalkSpeed = math.max(baseWalkSpeed, 16) end
	if hum.UseJumpPower and hum.JumpPower < 20 then hum.JumpPower = math.max(baseJumpPower, 50) end

	local st = hum:GetState()
	if st == Enum.HumanoidStateType.Physics
		or st == Enum.HumanoidStateType.Ragdoll
		or st == Enum.HumanoidStateType.FallingDown
		or st == Enum.HumanoidStateType.PlatformStanding then
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
	end
end

