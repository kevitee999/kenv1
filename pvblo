local function updateTargetLabel()
	if not targetLabel then return end
	if npcModeEnabled and currentNpc and isValidEnemy(currentNpc) then
		targetLabel.Text = "NPC: " .. currentNpc.Name
		targetLabel.TextColor3 = Color3.fromRGB(255, 140, 60)
	elseif currentTarget and isValidTarget(currentTarget) then
		targetLabel.Text = "Target: " .. currentTarget.DisplayName
		targetLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
	else
		targetLabel.Text = "Target: none"
		targetLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
	end
end

local function clearTarget(reason)
	local name = currentTarget and currentTarget.DisplayName or nil
	currentTarget = nil
	camLockOn = false
	_G.AimMethod = false
	isFollowingPlayer = false
	if followTween then
		pcall(function() followTween:Cancel() end)
		followTween = nil
	end
	local char = getChar()
	setFollowNoclip(char, false)
	destroyVisuals()
	if lockBtn then
		lockBtn.Text = "Cam Lock: OFF"
		lockBtn.TextColor3 = Color3.fromRGB(120, 255, 140)
	end
	updateTargetLabel()
	if refreshPlayerDropdown then refreshPlayerDropdown() end
	if reason == "dead" and name then
		notify("Target dead: " .. name)
	end
end

local function selectTargetFOV()
	if not silentAimEnabled then return end
	local best, bestAng = nil, 1e9
	local look = Camera.CFrame.LookVector
	local camPos = Camera.CFrame.Position
	for _, v in pairs(Players:GetPlayers()) do
		if isValidTarget(v) then
			local pos = v.Character.HumanoidRootPart.Position
			if inFOV(pos) then
				local ang = math.deg(math.acos(math.clamp((pos - camPos).Unit:Dot(look), -1, 1)))
				if ang < bestAng then bestAng = ang best = v end
			end
		end
	end
	if best then
		currentTarget = best
		_G.AimMethod = true
		camLockOn = true
		ABmethod = "Nearest Aim"
		MousePos = best.Character.HumanoidRootPart.Position
		if lockBtn then
			lockBtn.Text = "Cam Lock: " .. best.DisplayName
			lockBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
		end
		updateTargetLabel()
		if refreshPlayerDropdown then refreshPlayerDropdown() end
		print("[Target]", best.Name)
	end
end

