local function startFollowingTarget()
	if isFollowingPlayer then return end
	if not currentTarget or not isValidTarget(currentTarget) then return end

	isFollowingPlayer = true
	if followTween then
		pcall(function() followTween:Cancel() end)
		followTween = nil
	end

	notify("Following " .. currentTarget.DisplayName)

	task.spawn(function()
		while isFollowingPlayer and currentTarget and isValidTarget(currentTarget) do
			local char = getChar()
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local tHRP = currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")

			if hrp and tHRP then
				setFollowNoclip(char, true)
				local behindPos = tHRP.Position - tHRP.CFrame.LookVector * STICK_DIST
				local flatDist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
					- Vector3.new(behindPos.X, 0, behindPos.Z)).Magnitude

				if flatDist > ARRIVE_DIST then
					local travelGoal = behindPos + Vector3.new(0, TRAVEL_HEIGHT, 0)
					local offset = travelGoal - hrp.Position
					local dist = offset.Magnitude
					local step = math.min(dist, TRAVEL_SPEED * 0.03)
					if dist > 0.5 then
						hrp.CFrame = CFrame.new(hrp.Position + offset.Unit * step, behindPos)
					end
				else
					local stickPos = behindPos + Vector3.new(0, STICK_HEIGHT, 0)
					local goalCF = CFrame.new(stickPos, tHRP.Position)
					hrp.CFrame = hrp.CFrame:Lerp(goalCF, 0.28)
				end

				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				if hum then
					hum.PlatformStand = false
					hum.Sit = false
				end
			end
			task.wait()
		end

		local char = getChar()
		setFollowNoclip(char, false)
		isFollowingPlayer = false
		if followTween then
			pcall(function() followTween:Cancel() end)
			followTween = nil
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, gpe)
	if input.KeyCode == Enum.KeyCode.R then
		doSoruToTarget()
		return
	end
	if input.KeyCode == Enum.KeyCode.PageDown then
		if isFollowingPlayer then
			isFollowingPlayer = false
			if followTween then
				pcall(function() followTween:Cancel() end)
				followTween = nil
			end
			setFollowNoclip(getChar(), false)
			notify("Stopped following target")
			return
		end
		if not currentTarget or not isValidTarget(currentTarget) then
			notify("No target selected!")
			return
		end
		startFollowingTarget()
		return
	end
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.B then
		if not silentAimEnabled then return end
		if currentTarget and _G.AimMethod then
			clearTarget()
		else
			selectTargetFOV()
		end
	end
end)

