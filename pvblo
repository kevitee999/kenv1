-- ============================================================
local kenActive = false
local kenDisableConn = nil

local function stopAutoKen()
	kenActive = false
	if kenDisableConn then
		pcall(function() kenDisableConn:Disconnect() end)
		kenDisableConn = nil
	end
	pcall(function()
		local OM = require(ReplicatedStorage.Global).OM
		if OM then
			OM:setActive(false)
			OM:refresh()
		end
	end)
	-- Send server packet to completely disable Observation Haki in-game
	pcall(function()
		ReplicatedStorage.Remotes.CommE:FireServer("Ken", false)
	end)
end

local function startAutoKen()
	stopAutoKen()
	kenActive = true

	task.spawn(function()
		pcall(function()
			local MobileUIController_m = require(ReplicatedStorage.Controllers.UI.MobileUIController)
			local DisableKen = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DisableKen")
			local VisionRadius = plr:WaitForChild("VisionRadius")

			kenDisableConn = DisableKen.OnClientEvent:Connect(function()
				if not kenActive then return end
				local BoundActionKen = MobileUIController_m:GetContextButton("BoundActionKen")
				if BoundActionKen then
					BoundActionKen:SetAttribute("Selected", true)
				end
			end)

			local lastKenAttempt = 0

			while kenActive and autoKenEnabled do
				task.wait(0.3)
				local char = getChar()
				if not char then continue end
				local hum = char:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 or not char:IsDescendantOf(workspace) then continue end

				local OM = require(ReplicatedStorage.Global).OM
				if OM then
					OM.radius = math.clamp(OM.radius + VisionRadius.Value * 0.2, 0, VisionRadius.Value)
					OM:refresh()

					if not OM.active then
						if tick() - lastKenAttempt > 1.5 then
							lastKenAttempt = tick()
							OM:setActive(true)
							pcall(function()
								ReplicatedStorage.Remotes.CommE:FireServer("Ken", true)
							end)
						end
					end
				end
			end
		end)
	end)
end

