	pcall(function()
		writefile(CONFIG_FILE, HttpService:JSONEncode({
			silentAimEnabled = silentAimEnabled,
			antiStunEnabled = antiStunEnabled,
			soruEnabled = soruEnabled,
			autoKenEnabled = autoKenEnabled,
