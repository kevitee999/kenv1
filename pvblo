-- ============================================================
-- OWN SKILL TRACKING
-- ============================================================
local skillHeld = {
	[Enum.KeyCode.Z] = false,
	[Enum.KeyCode.X] = false,
	[Enum.KeyCode.C] = false,
	[Enum.KeyCode.V] = false,
}
local ownMoveUntil = 0

local function isUsingOwnMove()
	if tick() < ownMoveUntil then return true end
	for _, down in pairs(skillHeld) do
		if down then return true end
	end
	return false
end

UserInputService.InputBegan:Connect(function(input, gpe)
	if skillHeld[input.KeyCode] ~= nil then
		skillHeld[input.KeyCode] = true
		ownMoveUntil = tick() + 2.5
	end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
	if skillHeld[input.KeyCode] ~= nil then
		skillHeld[input.KeyCode] = false
		ownMoveUntil = tick() + 0.8
	end
end)

