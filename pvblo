local lockBtn, targetLabel

local function updateTargetLabel()
	if not targetLabel then return end
	if currentTarget and isValidTarget(currentTarget) then
		targetLabel.Text = "Target: " .. currentTarget.Name
		targetLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
	else
		targetLabel.Text = "Target: none"
		targetLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
	end
end

local function clearTarget(reason)
	local name = currentTarget and currentTarget.Name or nil
	currentTarget = nil
	camLockOn = false
	stickBehind = false
	_G.AimMethod = false
	destroyVisuals()
	if lockBtn then
		lockBtn.Text = "Cam Lock: OFF"
		lockBtn.TextColor3 = Color3.fromRGB(120, 255, 140)
	end
	updateTargetLabel()
	if reason == "dead" and name then
		notify("Target dead: " .. name)
	end
end

local function selectTargetFOV()
	if not silentAimEnabled then return end
	local best, bestAng = nil, 1e9
	local look = Camera.CFrame.LookVector
	local camPos = Camera.CFrame.Position
	for _, v in pairs(Players:GetPlayers()) do
		if isValidTarget(v) then
			local pos = v.Character.HumanoidRootPart.Position
			if inFOV(pos) then
				local ang = math.deg(math.acos(math.clamp((pos - camPos).Unit:Dot(look), -1, 1)))
				if ang < bestAng then bestAng = ang best = v end
			end
		end
	end
	if best then
		currentTarget = best
		_G.AimMethod = true
		ABmethod = "Nearest Aim"
		MousePos = best.Character.HumanoidRootPart.Position
		updateTargetLabel()
		print("[Target]", best.Name)
	end
end

task.spawn(function()
	while true do
		task.wait(0.2)
		if currentTarget and not isValidTarget(currentTarget) then
			clearTarget("dead")
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if input.KeyCode == Enum.KeyCode.R then
		doSoruToTarget()
		return
	end
	if input.KeyCode == Enum.KeyCode.PageDown then
		if not currentTarget or not isValidTarget(currentTarget) then
			print("[Stick] No target")
			return
		end
		stickBehind = not stickBehind
		notify(stickBehind and "Stick Behind: ON" or "Stick Behind: OFF")
		print("[Stick]", stickBehind and "ON" or "OFF")
		return
	end
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.B then
		if not silentAimEnabled then return end
		if currentTarget and _G.AimMethod then
			clearTarget()
		else
			selectTargetFOV()
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if camLockOn and currentTarget and isValidTarget(currentTarget) then
		local hrp = currentTarget.Character.HumanoidRootPart
		Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, hrp.Position), 0.15)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.15)
		if not silentAimEnabled then
			clearAllHighlights()
			destroyVisuals()
			continue
		end
		local seen = {}
		for _, v in pairs(Players:GetPlayers()) do
			if isValidTarget(v) then
				local char = v.Character
				local pos = char.HumanoidRootPart.Position
				if v == currentTarget then
					setHighlight(char, HIGHLIGHT_TARGET, 0.2)
					seen[char] = true
				elseif inFOV(pos) then
					setHighlight(char, HIGHLIGHT_FOV, 0.75)
					seen[char] = true
				end
			end
		end
		for char in pairs(highlights) do
			if not seen[char] then clearHighlight(char) end
		end
	end
end)

Players.PlayerRemoving:Connect(function(p)
	if currentTarget == p then clearTarget("dead") end
end)

local function makeDraggable(frame)
	local dragging, dragStart, startPos
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

