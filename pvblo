local function SaveConfig()
	if not writefile then return end
	pcall(function()
		writefile(CONFIG_FILE, HttpService:JSONEncode({
			silentAimEnabled = silentAimEnabled,
			antiStunEnabled = antiStunEnabled,
			soruEnabled = soruEnabled,
			autoKenEnabled = autoKenEnabled,
		}))
	end)
end

local function LoadConfig()
	if not isfile or not isfile(CONFIG_FILE) then return end
	pcall(function()
		local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
		if typeof(data.silentAimEnabled) == "boolean" then silentAimEnabled = data.silentAimEnabled end
		if typeof(data.antiStunEnabled) == "boolean" then antiStunEnabled = data.antiStunEnabled end
		if typeof(data.soruEnabled) == "boolean" then soruEnabled = data.soruEnabled end
		if typeof(data.autoKenEnabled) == "boolean" then autoKenEnabled = data.autoKenEnabled end
	end)
end
LoadConfig()
panelHidden = true

local function getChar()
	local c = plr.Character
	if c then return c end
	local folder = workspace:FindFirstChild("Characters")
	if folder then return folder:FindFirstChild(plr.Name) end
	return nil
end

local function isValidTarget(v)
	if v == plr then return false end
	if not v.Character or not v.Character:FindFirstChild("HumanoidRootPart") then return false end
	local hum = v.Character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	if v.Character:FindFirstChildOfClass("ForceField") then return false end
	if _G.NoAimTeam and v.Team and plr.Team and v.Team == plr.Team then return false end
	return true
end

local function inFOV(pos)
	local off = pos - Camera.CFrame.Position
	if off.Magnitude < 1 then return true end
	local ang = math.deg(math.acos(math.clamp(off.Unit:Dot(Camera.CFrame.LookVector), -1, 1)))
	return ang <= (FOV_DEG / 2)
end

local function getTargetEndCF(hrp)
	if not currentTarget or not isValidTarget(currentTarget) then return nil end
	local tHRP = currentTarget.Character:FindFirstChild("HumanoidRootPart")
	if not tHRP or not hrp then return nil end
	local startCF = hrp.CFrame
	return (startCF - startCF.Position) + tHRP.Position + Vector3.new(0, hrp.Size.Y * 1.5, 0)
end

local function forceToTarget()
	local char = getChar()
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local endCF = getTargetEndCF(hrp)
	if endCF and hrp then
		pcall(function() hrp.CFrame = endCF end)
	end
end

-- ============================================================
-- TRANSPARENT FORCEFIELD TARGET VISUALS
-- ============================================================
local bubblePart = nil
local sphereAdornment = nil
local bubbleLight = nil
local tracerBeam = nil
local att0, att1 = nil, nil

local function destroyVisuals()
	if bubblePart then pcall(function() bubblePart:Destroy() end) bubblePart = nil end
	if tracerBeam then pcall(function() tracerBeam:Destroy() end) tracerBeam = nil end
	if att0 then pcall(function() att0:Destroy() end) att0 = nil end
	if att1 then pcall(function() att1:Destroy() end) att1 = nil end
	sphereAdornment = nil
	bubbleLight = nil
end

local function updateVisuals()
	if not currentTarget or not isValidTarget(currentTarget) or not silentAimEnabled then
		destroyVisuals()
		return
	end
	local tHRP = currentTarget.Character:FindFirstChild("HumanoidRootPart")
	local myChar = getChar()
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not tHRP then destroyVisuals() return end

	if not bubblePart or not bubblePart.Parent then
		bubblePart = Instance.new("Part")
		bubblePart.Name = "TargetBubble"
		bubblePart.Shape = Enum.PartType.Ball
		bubblePart.Size = Vector3.new(12, 12, 12)
		bubblePart.Transparency = 0.85
		bubblePart.Color = Color3.fromRGB(255, 30, 30)
		bubblePart.Material = Enum.Material.ForceField
		bubblePart.CanCollide = false
		bubblePart.CanQuery = false
		bubblePart.CanTouch = false
		bubblePart.Anchored = true
		bubblePart.CastShadow = false
		bubblePart.Parent = workspace

		bubbleLight = Instance.new("PointLight")
		bubbleLight.Color = Color3.fromRGB(255, 50, 50)
		bubbleLight.Range = 12
		bubbleLight.Brightness = 0.8
		bubbleLight.Parent = bubblePart

		sphereAdornment = Instance.new("SphereHandleAdornment")
		sphereAdornment.Name = "TargetAdornment"
		sphereAdornment.Radius = 6.2
		sphereAdornment.Color3 = Color3.fromRGB(255, 0, 0)
		sphereAdornment.Transparency = 0.85
		sphereAdornment.AlwaysOnTop = true
		sphereAdornment.ZIndex = 5
		sphereAdornment.Adornee = bubblePart
		sphereAdornment.Parent = bubblePart
	end
	bubblePart.CFrame = tHRP.CFrame

	if myHRP then
		if not att0 or not att0.Parent then
			att0 = Instance.new("Attachment")
			att0.Name = "SA_Att0"
			att0.Parent = myHRP
		end
		if not att1 or not att1.Parent then
			att1 = Instance.new("Attachment")
			att1.Name = "SA_Att1"
			att1.Parent = tHRP
		else
			att1.Parent = tHRP
		end
		if not tracerBeam or not tracerBeam.Parent then
			tracerBeam = Instance.new("Beam")
			tracerBeam.Name = "SA_Tracer"
			tracerBeam.Attachment0 = att0
			tracerBeam.Attachment1 = att1
			tracerBeam.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50))
			tracerBeam.Width0 = 0.2
			tracerBeam.Width1 = 0.2
			tracerBeam.FaceCamera = true
			tracerBeam.LightEmission = 0.8
			tracerBeam.Transparency = NumberSequence.new(0.2)
			tracerBeam.Parent = myHRP
		else
			tracerBeam.Attachment0 = att0
			tracerBeam.Attachment1 = att1
		end
	end
end

-- ============================================================
-- NAMECALL HOOK
-- ============================================================
local gg = getrawmetatable(game)
local old = gg.__namecall
setreadonly(gg, false)
gg.__namecall = newcclosure(function(...)
	local method = getnamecallmethod()
	local args = { ... }

	if tostring(method) == "FireServer" then
		if soruEnabled and tostring(args[2]) == "Soru" then
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local endCF = getTargetEndCF(hrp)
			if endCF then
				args[4] = endCF
				task.defer(function()
					pcall(function() if hrp then hrp.CFrame = endCF end end)
				end)
				task.delay(0.05, function()
					pcall(function() if hrp and hrp.Parent then hrp.CFrame = endCF end end)
				end)
				return old(unpack(args))
			end
		end

		if tostring(args[1]) == "RemoteEvent" then
			if tostring(args[2]) ~= "true" and tostring(args[2]) ~= "false" then
				if silentAimEnabled and (
					(_G.AimMethod and ABmethod == "Aim Player")
					or (_G.AimMethod and ABmethod == "Nearest Aim")
				) then
					args[2] = MousePos
					return old(unpack(args))
				end
			end
		end
	end

	return old(...)
end)
setreadonly(gg, true)

