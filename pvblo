			tracerBeam.Width1 = 0.35
			tracerBeam.FaceCamera = true
			tracerBeam.LightEmission = 1
			tracerBeam.LightInfluence = 0
			tracerBeam.Transparency = NumberSequence.new(0)
			tracerBeam.Parent = myHRP
		else
