		if not currentNpc or not isValidEnemy(currentNpc) then
			currentNpc = getNearestEnemy(500)
		end
		if currentNpc then aimRoot = getEnemyRoot(currentNpc) end
	elseif currentTarget and isValidTarget(currentTarget) then
		aimRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
	end

	if not aimRoot then destroyVisuals() return end

	local myChar = getChar()
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if not bubblePart or not bubblePart.Parent then
		bubblePart = Instance.new("Part")
		bubblePart.Name = "TargetBubble"
		bubblePart.Shape = Enum.PartType.Ball
		bubblePart.Size = Vector3.new(18, 18, 18)
		bubblePart.Transparency = 0.5
		bubblePart.Color = Color3.fromRGB(255, 20, 20)
		bubblePart.Material = Enum.Material.Neon
		bubblePart.CanCollide = false
		bubblePart.CanQuery = false
		bubblePart.CanTouch = false
		bubblePart.Anchored = true
		bubblePart.CastShadow = false
		bubblePart.Parent = workspace

		local outer = Instance.new("Part")
		outer.Name = "TargetBubbleOuter"
		outer.Shape = Enum.PartType.Ball
		outer.Size = Vector3.new(24, 24, 24)
		outer.Transparency = 0.75
		outer.Color = Color3.fromRGB(255, 50, 50)
		outer.Material = Enum.Material.ForceField
		outer.CanCollide = false
		outer.CanQuery = false
		outer.CanTouch = false
		outer.Anchored = true
		outer.CastShadow = false
		outer.Parent = bubblePart

		bubbleLight = Instance.new("PointLight")
		bubbleLight.Color = Color3.fromRGB(255, 40, 40)
		bubbleLight.Range = 20
		bubbleLight.Brightness = 2
		bubbleLight.Parent = bubblePart

		sphereAdornment = Instance.new("SphereHandleAdornment")
		sphereAdornment.Adornee = bubblePart
		sphereAdornment.Radius = 9.5
		sphereAdornment.Color3 = Color3.fromRGB(255, 0, 0)
		sphereAdornment.Transparency = 0.7
