	if tracerBeam then pcall(function() tracerBeam:Destroy() end) tracerBeam = nil end
	if att0 then pcall(function() att0:Destroy() end) att0 = nil end
	if att1 then pcall(function() att1:Destroy() end) att1 = nil end
