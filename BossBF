-- ========================================================
-- 5. MOVEMENT, ANCHORED FLIGHT & SERVER HOPPER
-- ========================================================
local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if not root then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    local distance = (root.Position - targetCFrame.Position).Magnitude
    if distance > 2 then
        local duration = distance / FlySpeed
        local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end
end

local function flyStraightUp()
    task.spawn(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart", 10)
        if not root then return end

        -- Anchor character so physics/gravity/anti-cheat cannot pull you down
        root.Anchored = true

        Notify("Skyward Flight", "Flying straight up at speed 180...", 3)

        -- Smoothly move straight up every single frame
        RunService.RenderStepped:Connect(function(dt)
            if root and root.Parent then
                root.CFrame = root.CFrame + Vector3.new(0, 180 * dt, 0)
            end
        end)
    end)
end

local isHopping = false
local function ServerHop(preferRegion)
    if isHopping then return end
    isHopping = true

    -- Start true anchored flight straight up
    flyStraightUp()

    task.spawn(function()
        while true do
            Notify("Server Hop", "Scanning available servers...", 2.5)

            local currentJob
            pcall(function()
                currentJob = ServerBrowser:InvokeServer("getjob")
            end)

            local allServers = {}

            for i = 1, 100 do
                local success, result = pcall(function()
                    return ServerBrowser:InvokeServer(i)
                end)

                if success and type(result) == "table" then
                    for jobId, data in pairs(result) do
                        if jobId ~= currentJob then
                            data.Job = jobId
                            table.insert(allServers, data)
                        end
                    end
                end

                task.wait(0.01)
            end

            Notify("Server Hop", "Found " .. tostring(#allServers) .. " potential servers.", 2.5)

            if #allServers > 0 then
                local filtered = {}
                if preferRegion and preferRegion ~= "" then
                    local regionLower = string.lower(preferRegion)
                    for _, server in ipairs(allServers) do
                        if server.Region and string.find(string.lower(server.Region), regionLower) then
                            table.insert(filtered, server)
                        end
                    end
                end

                local targetList = (#filtered > 0) and filtered or allServers

                table.sort(targetList, function(a, b)
                    return (a.Count or 99) < (b.Count or 99)
                end)

                local chosen = targetList[math.random(1, math.min(15, #targetList))]

                Notify("Teleporting", "Target: " .. tostring(chosen.Region or "Unknown") .. " | Players: " .. tostring(chosen.Count), 4)

                for attempt = 1, 5 do
                    local success, err = pcall(function()
                        ServerBrowser:InvokeServer("teleport", chosen.Job)
                    end)

                    if not success then
                        Notify("Teleport Retry", "Attempt " .. tostring(attempt) .. " failed, retrying...", 1.5)
                    end
                    task.wait(0.5)
                end
            else
                Notify("Server Hop", "No servers found. Rescanning...", 2)
            end

            task.wait(1)
        end
    end)
end

-- ========================================================
-- MAIN EXECUTION FLOW
-- ========================================================
task.spawn(function()
    Notify("Script Initialized", "Starting Magma Admiral Auto-Farm...", 3)

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")

    ensureBuso()
    task.wait(2)

    -- Step 1: Go to Magma Island Position
    Notify("Navigation", "Flying to Magma Island...", 3)
    tweenTo(CFrame.new(TargetPos))

    -- Step 2: Check for Boss
    local enemyFolder = workspace:WaitForChild("Enemies", 10)
    local boss = enemyFolder and enemyFolder:FindFirstChild(BossName)

    if not boss or not boss:FindFirstChild("Humanoid") or boss.Humanoid.Health <= 0 then
        Notify("Target Missing", BossName .. " not found! Flying up & hopping...", 4)
        ServerHop(TARGET_REGION)
        return
    end

    -- Step 3: Boss Combat Loop
    Notify("Boss Found", "Engaging " .. BossName .. "!", 3)
    while boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 do
        local bossHrp = boss:FindFirstChild("HumanoidRootPart")
        if bossHrp then
            tweenTo(bossHrp.CFrame * CFrame.new(0, 10, 0))
        end
        task.wait(0.1)
    end

    -- Step 4: Boss defeated -> Fly up and Server Hop
    Notify("Target Defeated", BossName .. " killed! Flying up & hopping...", 4)
    ServerHop(TARGET_REGION)
end)
