-- ==========================
-- CONFIGURATION SYSTEM
-- ==========================
local function SaveConfig()
    if writefile then
        local configData = {
            flySpeed = flySpeed,
            infJump = infJump,
            energyBlocked = energyBlocked,
            safeMode = safeMode,
            safeModeHp = safeModeHp,
            noclip = noclip
        }
        pcall(function()
            writefile(configFile, HttpService:JSONEncode(configData))
        end)
    end
end

local function LoadConfig()
    if isfile and isfile(configFile) and readfile then
        pcall(function()
            local decoded = HttpService:JSONDecode(readfile(configFile))
            if decoded then
                flySpeed = decoded.flySpeed or 50
                infJump = decoded.infJump or false
                energyBlocked = decoded.energyBlocked or false
                safeMode = decoded.safeMode or false
                safeModeHp = decoded.safeModeHp or 38
                noclip = decoded.noclip or false
            end
        end)
    end
end

LoadConfig()

-- ==========================
-- HOOKING (Energy Saver)
-- ==========================
local success, err = pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall

    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if energyBlocked and method == "FireServer" and tostring(self) == "CommE" then
            if args[1] == "Dodge" or args[1] == "DoubleJump" then
                return -- Block remote
            end
        end
        
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)
if not success then warn("Failed to hook metatable: " .. tostring(err)) end

