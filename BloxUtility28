RunService.Heartbeat:Connect(function()
    if safeMode and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if hum and hrp and hum.Health > 0 then
            if safeModeTriggered then
                if hum.Health >= (hum.MaxHealth * 0.65) then
                    safeModeTriggered = false
                    hrp.Anchored = false
                else
                    if hrp.Position.Y < 20000 then
                        -- Actively fly straight up at a physical speed of 250 (fully replicates to friends/server)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 250, 0)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.Anchored = false
                    else
                        -- Reached Y = 20000, lock in place securely until health recovers
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.CFrame = CFrame.new(hrp.Position.X, 20000, hrp.Position.Z)
                        hrp.Anchored = true
                    end
                end
            else
                if hum.Health <= (hum.MaxHealth * (safeModeHp / 100)) then
                    safeModeTriggered = true
                    hrp.Anchored = false
                end
            end
        end
    else
        if safeModeTriggered and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = false end
        end
        safeModeTriggered = false
    end
end)

