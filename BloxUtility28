-- Robust Click & Drag Logic (Fixes close/open toggle bug)
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
local movedDistance = 0

PingBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = PingBtn.Position
        movedDistance = 0
        
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                connection:Disconnect()
                if movedDistance < 6 then
                    MainFrame.Visible = not MainFrame.Visible
                end
            end
        end)
    end
end)

PingBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        movedDistance = delta.Magnitude
        PingBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Accurate Roblox Ping Loop
task.spawn(function()
    while task.wait(0.5) do
        local pingVal = 0
        local ok, netPing = pcall(function()
            return LocalPlayer:GetNetworkPing()
        end)
        if ok and netPing then
            pingVal = math.round(netPing * 1000)
        else
            pcall(function()
                pingVal = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
        end
        PingBtn.Text = "Ping: " .. tostring(pingVal)
    end
end)

