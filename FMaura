local PhaseTextures = {
    ["9709136820"] = "0/5",
    ["9709136123"] = "0/5",
    ["9709135895"] = "0/5",
    ["9709137525"] = "0/5",
    ["9709139409"] = "1/5",
    ["9709139053"] = "1/5",
    ["9709141700"] = "2/5",
    ["9709141315"] = "2/5",
    ["9709143733"] = "3/5",
    ["9709143210"] = "3/5",
    ["9709145889"] = "4/5",
    ["9709145412"] = "4/5",
    ["9709149431"] = "5/5",
    ["9709149053"] = "5/5"
}

task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local sky = Lighting:FindFirstChildOfClass("Sky") or Lighting:FindFirstChild("FantasySky")
            local moonId = sky and sky.MoonTextureId or ""
            local clockTime = Lighting.ClockTime

            local currentPhase = "0/5"
            for id, phase in pairs(PhaseTextures) do
                if string.find(moonId, id) then
                    currentPhase = phase
                    break
                end
            end

            MoonPhaseLabel.Text = "Moon: " .. currentPhase

            if currentPhase == "5/5" then
                MoonTitleLabel.Text = "Full Moon"
                MoonTitleLabel.TextColor3 = Color3.fromRGB(0, 255, 120)

                local hoursLeft = 0
                if clockTime >= 18 then
                    hoursLeft = (24 - clockTime) + 5.5
                elseif clockTime < 5.5 then
                    hoursLeft = 5.5 - clockTime
                else
                    hoursLeft = (18 - clockTime) + 5.5
                end

                local realSeconds = math.max(0, math.floor(hoursLeft * 50))
                local mins = math.floor(realSeconds / 60)
                local secs = realSeconds % 60
                MoonTimerLabel.Text = string.format("Ends: %02dm %02ds", mins, secs)
            else
                MoonTitleLabel.Text = "Normal Moon"
                MoonTitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)

                local hoursLeft = 0
                if clockTime >= 18 then
                    hoursLeft = (24 - clockTime) + 18
                else
                    hoursLeft = 18 - clockTime
                end

                local realSeconds = math.max(0, math.floor(hoursLeft * 50))
                local mins = math.floor(realSeconds / 60)
                local secs = realSeconds % 60
                MoonTimerLabel.Text = string.format("Next: %02dm %02ds", mins, secs)
            end
        end)
    end
end)

