local function StopSpectate()
	spectating = false
	currentSpectateTarget = nil
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
		Camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	end
	for _, btn in pairs(spectateButtons) do
		if btn and btn.Parent then
			btn.TextColor3 = Color3.fromRGB(255, 255, 180)
		end
	end
end

local function StartSpectate(player)
	if not player or not player.Character then return end
	local hum = player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	spectating = true
	currentSpectateTarget = player
	Camera.CameraSubject = hum
end

local function RefreshSpectateList()
	for _, btn in pairs(spectateButtons) do
		if btn and btn.Parent then
			btn:Destroy()
		end
	end
	spectateButtons = {}

	local ySize = 0
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -4, 0, 24)
			btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
			btn.BorderColor3 = Color3.fromRGB(60, 60, 60)
			btn.TextColor3 = Color3.fromRGB(255, 255, 180)
			btn.TextSize = 13
			btn.Font = Enum.Font.GothamBold
			btn.TextStrokeTransparency = 0.6
			btn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			btn.Text = player.DisplayName
			btn.Parent = SpectateFrame

			if currentSpectateTarget == player then
				btn.TextColor3 = Color3.fromRGB(255, 80, 80)
			end

			btn.MouseButton1Click:Connect(function()
				if currentSpectateTarget == player then
					StopSpectate()
					btn.TextColor3 = Color3.fromRGB(255, 255, 180)
				else
					StopSpectate()
					StartSpectate(player)
					btn.TextColor3 = Color3.fromRGB(255, 80, 80)
				end
			end)

			table.insert(spectateButtons, btn)
			ySize = ySize + 26
		end
	end
	SpectateFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

SpectateBtn.MouseButton1Click:Connect(function()
