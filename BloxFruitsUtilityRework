-- Physics-based Tween Connection (Using Fly Logic to Bypass Anti-Cheat)
local activeTweenConnection = nil
local currentTweenTarget = nil
local tweenVelocity = nil
local tweenAttachment = nil
local tweenGyro = nil

local function StopAllTweens()
	if activeTweenConnection then
		activeTweenConnection:Disconnect()
		activeTweenConnection = nil
	end
	if tweenVelocity then
		tweenVelocity:Destroy()
		tweenVelocity = nil
	end
	if tweenAttachment then
		tweenAttachment:Destroy()
		tweenAttachment = nil
	end
	if tweenGyro then
		tweenGyro:Destroy()
		tweenGyro = nil
	end
	currentTweenTarget = nil
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if not flying and not safeModeTriggered then
		noclip = false
	end
end

local function StartCustomTween(targetPos, targetName, onComplete)
	StopAllTweens()

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	currentTweenTarget = targetName
	noclip = true

	local endPos = targetPos

	tweenAttachment = Instance.new("Attachment", hrp)
	tweenVelocity = Instance.new("LinearVelocity", hrp)
	tweenVelocity.Attachment0 = tweenAttachment
	tweenVelocity.MaxForce = math.huge
	tweenVelocity.RelativeTo = Enum.ActuatorRelativeTo.World

	tweenGyro = Instance.new("AlignOrientation", hrp)
	tweenGyro.Attachment0 = tweenAttachment
	tweenGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
	tweenGyro.MaxTorque = math.huge
	tweenGyro.Responsiveness = 200

	activeTweenConnection = RunService.Heartbeat:Connect(function()
		if not hrp or not hrp.Parent then
			StopAllTweens()
			return
		end

		local currentPos = hrp.Position
		local direction = (endPos - currentPos)
		local distance = direction.Magnitude

		if distance < 5 then
			StopAllTweens()
			if onComplete then onComplete() end
			return
		end

		local currentSpeed = math.min(flySpeed, distance * 20)
		tweenVelocity.VectorVelocity = direction.Unit * currentSpeed
		tweenGyro.CFrame = CFrame.new(currentPos, endPos)
	end)
end

