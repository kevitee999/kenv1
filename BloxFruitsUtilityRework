local function clearHighlight(char)
	local h = highlights[char]
	if h then pcall(function() h:Destroy() end) highlights[char] = nil end
end

local function setHighlight(char, color, fill)
	if not char or not char.Parent then return end
	local h = highlights[char]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "CamLockHL"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = char
		highlights[char] = h
	end
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = fill or 0.3
	h.OutlineTransparency = 0
	h.Enabled = true
end

local function clearAllHighlights()
	for char in pairs(highlights) do clearHighlight(char) end
end

local function notify(text)
	local g = Instance.new("ScreenGui")
	g.Name = "SA_Notify"
	g.ResetOnSpawn = false
