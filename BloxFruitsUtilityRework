		hum.JumpPower = flySpeed
		pcall(function() hum.JumpHeight = flySpeed / 5 end)

		if tick() - lastSafeJump > 0.1 then
			if flying and flightVelocity then
				flightVelocity.VectorVelocity = Vector3.new(0, flySpeed, 0)
			else
				hum.Jump = true
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
				local vel = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, flySpeed, vel.Z)
