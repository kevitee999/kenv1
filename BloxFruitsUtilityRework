local function ClearRaidESP()
	if raidESPFolder then
		raidESPFolder:Destroy()
		raidESPFolder = nil
	end
end

local function CreateRaidESP()
	ClearRaidESP()
	raidESPFolder = Instance.new("Folder")
	raidESPFolder.Name = "RaidESPFolder"
	raidESPFolder.Parent = workspace

	local map = workspace:FindFirstChild("Map")
	local raidMap = map and map:FindFirstChild("RaidMap")

	if raidMap then
		for _, child in pairs(raidMap:GetChildren()) do
			if string.find(child.Name, "RaidIsland") then
				local targetPart = child:IsA("Model") and (child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)) or child
				if targetPart and targetPart:IsA("BasePart") then
					local part = Instance.new("Part")
					part.Size = Vector3.new(1, 1, 1)
					part.Position = targetPart.Position
					part.Anchored = true
					part.CanCollide = false
					part.Transparency = 1
					part.Parent = raidESPFolder

					local billboard = Instance.new("BillboardGui")
					billboard.Size = UDim2.new(0, 200, 0, 50)
					billboard.StudsOffset = Vector3.new(0, 10, 0)
					billboard.AlwaysOnTop = true
					billboard.Parent = part

					local label = Instance.new("TextLabel")
					label.Size = UDim2.new(1, 0, 1, 0)
					label.BackgroundTransparency = 1
					label.Text = child.Name
					label.TextColor3 = Color3.fromRGB(255, 100, 255)
					label.TextStrokeTransparency = 0.3
					label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
					label.TextSize = 14
					label.Font = Enum.Font.GothamBold
					label.Parent = billboard
				end
			end
		end
	end
end

local function RefreshRaidList()
	for _, btn in pairs(raidButtons) do
		if btn and btn.Parent then btn:Destroy() end
	end
	raidButtons = {}

	local map = workspace:FindFirstChild("Map")
	local raidMap = map and map:FindFirstChild("RaidMap")
	local ySize = 0

	if raidMap then
		for _, child in pairs(raidMap:GetChildren()) do
			if string.find(child.Name, "RaidIsland") then
				local targetPart = child:IsA("Model") and (child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)) or child
				if targetPart and targetPart:IsA("BasePart") then
					local btn = createButton(child.Name, RaidFrame)
					btn.MouseButton1Click:Connect(function()
						for _, b in pairs(raidButtons) do
							if b and b.Parent then b.TextColor3 = Color3.fromRGB(200, 200, 200) end
						end
						btn.TextColor3 = Color3.fromRGB(255, 100, 100)
						StartCustomTween(targetPart.Position + Vector3.new(0, 10, 0), child.Name, function()
							btn.TextColor3 = Color3.fromRGB(200, 200, 200)
						end)
					end)
					table.insert(raidButtons, btn)
					ySize = ySize + 20
				end
			end
		end
	end
	RaidFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

