local function RefreshFruitList()
	for _, btn in pairs(fruitButtons) do
		if btn and btn.Parent then btn:Destroy() end
	end
	fruitButtons = {}

	local ySize = 0
	for fruitModel, espPart in pairs(activeFruitESPs) do
		if fruitModel and fruitModel.Parent then
			local targetPart = fruitModel:FindFirstChild("Handle") or fruitModel.PrimaryPart or fruitModel:FindFirstChildWhichIsA("BasePart")
			if targetPart then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -4, 0, 24)
				btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
				btn.BorderColor3 = Color3.fromRGB(60, 60, 60)
				btn.TextColor3 = Color3.fromRGB(255, 255, 180)
				btn.TextSize = 11
				btn.Font = Enum.Font.GothamBold
				btn.Text = "🍎 " .. fruitModel.Name .. " ➔"
				btn.Parent = FruitFrame

				if currentTweenTarget == fruitModel.Name then
					btn.TextColor3 = Color3.fromRGB(255, 80, 80)
				end

				btn.MouseButton1Click:Connect(function()
					if currentTweenTarget == fruitModel.Name then
						StopAllTweens()
						btn.TextColor3 = Color3.fromRGB(255, 255, 180)
					else
						for _, b in pairs(fruitButtons) do
							if b and b.Parent then b.TextColor3 = Color3.fromRGB(255, 255, 180) end
						end
						btn.TextColor3 = Color3.fromRGB(255, 80, 80)
						StartCustomTween(targetPart.Position + Vector3.new(0, 5, 0), fruitModel.Name, function()
							btn.TextColor3 = Color3.fromRGB(255, 255, 180)
						end)
					end
				end)

				table.insert(fruitButtons, btn)
				ySize = ySize + 26
			end
		end
	end
	FruitFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

local function UpdateFruitESP()
	if not fruitESPFolder or not fruitESPFolder.Parent then
		fruitESPFolder = Instance.new("Folder")
		fruitESPFolder.Name = "FruitESPFolder"
		fruitESPFolder.Parent = workspace
	end

	local currentFound = {}

	local function processFruit(child, isSpecial)
		local targetPart = nil
		if child:IsA("BasePart") then
			targetPart = child
		else
			targetPart = child:FindFirstChild("Handle") or child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
		end

		if targetPart then
			currentFound[child] = true

			if not activeFruitESPs[child] then
				local part = Instance.new("Part")
				part.Size = Vector3.new(1, 1, 1)
				part.Position = targetPart.Position
				part.Anchored = true
				part.CanCollide = false
				part.Transparency = 1
				part.Parent = fruitESPFolder

				local billboard = Instance.new("BillboardGui")
				billboard.Size = UDim2.new(0, 200, 0, 50)
				billboard.StudsOffset = Vector3.new(0, 3, 0)
				billboard.AlwaysOnTop = true
				billboard.Parent = part

				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, 0, 1, 0)
				label.BackgroundTransparency = 1
				label.Text = "🍎 " .. child.Name
				label.TextColor3 = Color3.fromRGB(255, 0, 0)
				label.TextStrokeTransparency = 0.2
				label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				
				if isSpecial then
					label.TextSize = 35
				else
					label.TextSize = 25
				end

				label.Font = Enum.Font.GothamBold
				label.Parent = billboard

				activeFruitESPs[child] = part
			else
				if activeFruitESPs[child] then
					activeFruitESPs[child].Position = targetPart.Position
				end
			end
		end
	end

	-- Always process the special workspace["Fruit "].Fruit regardless of toggle
	local fruitSpaceFolder = workspace:FindFirstChild("Fruit ")
	if fruitSpaceFolder then
		local specialFruit = fruitSpaceFolder:FindFirstChild("Fruit")
		if specialFruit then
			processFruit(specialFruit, true)
		end
	end

	-- Only process regular fruits in workspace if toggle is ON to reduce lag
	if fruitESPEnabled then
		for _, child in ipairs(workspace:GetChildren()) do
			-- Exact string matching completely filters out fruit effects
			if validFruitNames[child.Name] then
				processFruit(child, false)
			end
		end
	end

	-- Clear removed / toggled-off fruit ESPs while maintaining the special fruit
	for fruitModel, espPart in pairs(activeFruitESPs) do
		if not currentFound[fruitModel] or not fruitModel.Parent then
			if espPart then
				espPart:Destroy()
			end
			activeFruitESPs[fruitModel] = nil
		end
	end

	if FruitFrame.Visible then
		RefreshFruitList()
	end
end

