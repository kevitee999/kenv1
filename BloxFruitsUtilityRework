local lastHealth = 0
RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if hum and hum.Health > 0 then
		if safeMode then
			if hum.Health < lastHealth and hum.Health <= safeModeHp then
				safeModeTriggered = true
			end
			if safeModeTriggered and hum.Health >= (hum.MaxHealth - 1) then
				safeModeTriggered = false
			end
		else
			safeModeTriggered = false
		end
		lastHealth = hum.Health
	end

	if safeModeTriggered then
		noclip = true
	else
		noclip = flying or (activeTweenConnection ~= nil)
	end

