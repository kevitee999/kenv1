local function doSoruToTarget()
	if not soruEnabled then return end
	if tick() - lastSoru < SORU_CD then return end
	local char = getChar()
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	if not currentTarget or not isValidTarget(currentTarget) then
		print("[Soru] No target — press B first")
		return
	end
	local startCF = hrp.CFrame
	local endCF = getTargetEndCF(hrp)
	if not endCF then return end
	pcall(function()
		ReplicatedStorage.Remotes.CommE:FireServer("Soru", startCF, endCF, workspace:GetServerTimeNow(), math.random(1, 999999999))
	end)
	pcall(function() hrp.CFrame = endCF end)
	task.delay(0.03, forceToTarget)
	task.delay(0.08, forceToTarget)
	lastSoru = tick()
	print("[Soru] →", currentTarget.Name)
end

-- ============================================================
-- SAFE ANTI-STUN (DOES NOT BREAK GAME SCRIPTS, CAN TURN OFF)
-- ============================================================
local function applyAntiStun()
	-- Strictly check toggle state: if off, exit without changing anything
	if not antiStunEnabled then return end
	if isUsingOwnMove() then return end

	local char = getChar()
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then return end

	-- Zero out Stun value without destroying game instances
	local stun = char:FindFirstChild("Stun") or hrp:FindFirstChild("Stun")
	if stun and (stun:IsA("NumberValue") or stun:IsA("IntValue")) and stun.Value ~= 0 then
		stun.Value = 0
	end

	-- Disable force locks by setting MaxForce to zero instead of Destroying
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BodyVelocity") or obj:IsA("LinearVelocity") then
			if obj.Velocity.Magnitude < 3 and obj.MaxForce.Magnitude > 1000 then
				pcall(function() obj.MaxForce = Vector3.zero end)
			end
		elseif obj:IsA("BodyPosition") or obj:IsA("AlignPosition") then
			if obj:IsA("BodyPosition") then
				pcall(function() obj.MaxForce = Vector3.zero end)
			end
		end
	end

	-- Clear lock/stun attributes non-destructively
	pcall(function()
		for _, inst in ipairs({ char, hum, hrp }) do
			for attr, val in pairs(inst:GetAttributes()) do
				local n = string.lower(tostring(attr))
				if n:find("stun") or n:find("busy") or n:find("freeze") or n:find("nomove") then
					if typeof(val) == "boolean" and val == true then
						inst:SetAttribute(attr, false)
					elseif typeof(val) == "number" and val > 0 then
						inst:SetAttribute(attr, 0)
					end
				end
				if n == "canmove" or n == "canwalk" then
					inst:SetAttribute(attr, true)
				end
			end
		end
	end)

	-- Restore movement controls
	if hrp.Anchored then hrp.Anchored = false end
	if hum.PlatformStand then hum.PlatformStand = false end
	if hum.Sit then hum.Sit = false end
	hum.AutoRotate = true

	if hum.WalkSpeed < 12 then
		hum.WalkSpeed = math.max(baseWalkSpeed, 16)
	end

	local st = hum:GetState()
	if st == Enum.HumanoidStateType.Physics
		or st == Enum.HumanoidStateType.Ragdoll
		or st == Enum.HumanoidStateType.FallingDown
		or st == Enum.HumanoidStateType.PlatformStanding then
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
	end
end

RunService.Heartbeat:Connect(function()
