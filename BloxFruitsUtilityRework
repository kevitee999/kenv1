-- ==========================
-- FAST ATTACK (Improved)
-- ==========================
local function GetNearbyTargets(range)
	local targets = {}
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return targets end

	for _, enemy in pairs(workspace.Enemies:GetChildren()) do
		local hum = enemy:FindFirstChildOfClass("Humanoid")
		local hrp = enemy:FindFirstChild("HumanoidRootPart")
		if hum and hrp and hum.Health > 0 then
			if (hrp.Position - root.Position).Magnitude <= range then
				table.insert(targets, enemy)
			end
		end
	end

	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health > 0 then
				if (hrp.Position - root.Position).Magnitude <= range then
					table.insert(targets, plr.Character)
				end
			end
		end
	end
	return targets
end

local function StartFastAttack()
	if fastAttackThread then return end

	fastAttackThread = task.spawn(function()
		while fastAttack do
			pcall(function()
				local char = LocalPlayer.Character
				if not char then return end
				local tool = char:FindFirstChildOfClass("Tool")
				if not tool then return end

				local targets = GetNearbyTargets(60)
				if #targets == 0 then return end

				local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
				if not Net then return end

				local attackRemote = Net:FindFirstChild("RE/RegisterAttack")
				local hitRemote = Net:FindFirstChild("RE/RegisterHit")

				if attackRemote and hitRemote then
					local hitList = {}
					for _, target in pairs(targets) do
						local head = target:FindFirstChild("Head") or target.PrimaryPart
						if head then
							table.insert(hitList, {target, head})
						end
					end
					if #hitList > 0 then
						attackRemote:FireServer(0.000000002)
						hitRemote:FireServer(hitList[1][2], hitList)
					end
				end
			end)
			task.wait(0.08) -- Reduced lag
		end
		fastAttackThread = nil
	end)
end

local function StopFastAttack()
	fastAttack = false
	fastAttackThread = nil
end

