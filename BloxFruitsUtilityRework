local function CreateIslandESP()
	ClearIslandESP()
	islandESPFolder = Instance.new("Folder")
	islandESPFolder.Name = "IslandESP"
	islandESPFolder.Parent = workspace

	local islands = GetCurrentSeaIslands()
	for _, data in ipairs(islands) do
		local part = Instance.new("Part")
		part.Size = Vector3.new(1, 1, 1)
		part.Position = data.Pos
		part.Anchored = true
		part.CanCollide = false
