local function getInfinity_Soru(Var)
	task.spawn(function()
		local soruTable = nil
		while Var do
			if soruTable then
				pcall(function()
					soruTable.LastUse = 0
				end)
				task.wait(0.1)
			else
				pcall(function()
					for _, gc in next, getgc() do
						if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Soru") then
							if typeof(gc) == "function" and getfenv(gc).script == LocalPlayer.Character.Soru then
								for _, v in next, getupvalues(gc) do
									if typeof(v) == "table" and v.LastUse ~= nil then
										soruTable = v
										break
									end
								end
							end
						end
					end
				end)
				if not soruTable then
					task.wait(1)
				end
			end
		end
	end)
end

