local function SaveConfig()
	if writefile then
		pcall(function()
			writefile(configFile, HttpService:JSONEncode({
				flySpeed = flySpeed,
				infJump = infJump,
				energyBlocked = energyBlocked,
				safeMode = safeMode,
				safeModeHp = safeModeHp,
				noclip = noclip,
				jump500Toggle = jump500Toggle,
				dashToggle = dashToggle,
				dashMultiplier = dashMultiplier,
				fastFallToggle = fastFallToggle,
				fastAttack = fastAttack
			}))
		end)
	end
end

local function LoadConfig()
	if isfile and isfile(configFile) and readfile then
		pcall(function()
			local d = HttpService:JSONDecode(readfile(configFile))
			if d then
				flySpeed = d.flySpeed or 50
				infJump = d.infJump or false
				energyBlocked = d.energyBlocked or false
				safeMode = d.safeMode or false
				safeModeHp = d.safeModeHp or 3000
				noclip = d.noclip or false
				jump500Toggle = d.jump500Toggle or false
				dashToggle = d.dashToggle or false
				dashMultiplier = d.dashMultiplier or 1.5
				fastFallToggle = d.fastFallToggle or false
				fastAttack = d.fastAttack or false
			end
		end)
	end
end
LoadConfig()

-- ==========================
-- REMOTES HOOK
-- ==========================
pcall(function()
	local mt = getrawmetatable(game)
	local old = mt.__namecall
	setreadonly(mt, false)
	mt.__namecall = newcclosure(function(self, ...)
		local method = getnamecallmethod()
		local args = {...}
		if method == "FireServer" and tostring(self) == "CommE" then
			if energyBlocked and (args[1] == "Dodge" or args[1] == "DoubleJump") then
				return
			end
		end
		return old(self, ...)
	end)
	setreadonly(mt, true)
end)

