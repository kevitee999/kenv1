		pcall(function()
			hum.JumpHeight = 50
		end)
		task.defer(function()
			if hrp and hrp.Parent then
				local vel = hrp.AssemblyLinearVelocity
				if vel.Y < 160 then
					hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 180, vel.Z)
				end
			end
		end)
	elseif infJump then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- Heartbeat
local lastHealth = 0
RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if hum and hum.Health > 0 then
		if safeMode then
			if hum.Health < lastHealth and hum.Health <= safeModeHp then
				safeModeTriggered = true
			end
			if safeModeTriggered and hum.Health >= (hum.MaxHealth - 1) then
				safeModeTriggered = false
			end
		else
			safeModeTriggered = false
		end
		lastHealth = hum.Health
	end

	if safeModeTriggered then
		noclip = true
	else
		noclip = flying
	end

	if not flying and hum and hrp then
		if fastFallToggle then
			if hum.FloorMaterial == Enum.Material.Air and hrp.AssemblyLinearVelocity.Y < -2 then
				workspace.Gravity = fastFallGravity
			else
				workspace.Gravity = normalGravity
			end
		else
			workspace.Gravity = normalGravity
		end
	end
end)

-- Render
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	if dashToggle then
		local val = (dashMultiplier - 1) * 90
		char:SetAttribute("DashLength", val)
		char:SetAttribute("AirDashLength", val)
		char:SetAttribute("DodgeLength", val)
		char:SetAttribute("AirDodgeLength", val)
	end

	if jump500Toggle or safeModeTriggered then
		hum.UseJumpPower = true
		hum.JumpPower = 500
		pcall(function() hum.JumpHeight = 50 end)

		if safeModeTriggered and tick() - lastSafeJump > 0.1 then
			if flying and flightVelocity then
				flightVelocity.VectorVelocity = Vector3.new(0, math.max(flySpeed, 80), 0)
			else
				hum.Jump = true
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
				local vel = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 180, vel.Z)
			end
			lastSafeJump = tick()
		end
	else
		hum.UseJumpPower = true
		hum.JumpPower = 50
		pcall(function() hum.JumpHeight = 7.2 end)
	end

	if flying and flightVelocity and flightGyro then
		if not (safeModeTriggered and tick() - lastSafeJump < 0.12) then
			local moveDir = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += Camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= Camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= Camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += Camera.CFrame.RightVector end
			if moveDir.Magnitude > 0 then
				moveDir = moveDir.Unit
			end
			flightVelocity.VectorVelocity = moveDir * flySpeed
		end
		flightGyro.CFrame = Camera.CFrame
	end

	if spectating and currentSpectateTarget and currentSpectateTarget.Character then
		local hum2 = currentSpectateTarget.Character:FindFirstChildOfClass("Humanoid")
		if hum2 and Camera.CameraSubject ~= hum2 then
			Camera.CameraSubject = hum2
		end
	end
end)

-- Noclip
RunService.Stepped:Connect(function()
	if noclip and LocalPlayer.Character then
		for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
end)

