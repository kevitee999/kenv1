		end
		lastHealth = hum.Health
	end

	if safeModeTriggered then
		noclip = true
	else
		noclip = flying or (activeTweenConnection ~= nil)
	end

	if not flying and hum and hrp then
		if fastFallToggle then
			if hum.FloorMaterial == Enum.Material.Air and hrp.AssemblyLinearVelocity.Y < -2 then
				workspace.Gravity = fastFallGravity
			else
				workspace.Gravity = normalGravity
			end
		else
			workspace.Gravity = normalGravity
		end
	end
end)

-- Render
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	if dashToggle then
		local val = (dashMultiplier - 1) * 90
		char:SetAttribute("DashLength", val)
		char:SetAttribute("AirDashLength", val)
		char:SetAttribute("DodgeLength", val)
		char:SetAttribute("AirDodgeLength", val)
	end

	if safeModeTriggered then
		hum.UseJumpPower = true
		hum.JumpPower = flySpeed
		pcall(function() hum.JumpHeight = flySpeed / 5 end)

		if tick() - lastSafeJump > 0.1 then
			if flying and flightVelocity then
				flightVelocity.VectorVelocity = Vector3.new(0, flySpeed, 0)
			else
				hum.Jump = true
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
				local vel = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, flySpeed, vel.Z)
			end
			lastSafeJump = tick()
		end
	elseif jump500Toggle then
		hum.UseJumpPower = true
		hum.JumpPower = 500
		pcall(function() hum.JumpHeight = 50 end)
	else
		hum.UseJumpPower = true
		hum.JumpPower = 50
		pcall(function() hum.JumpHeight = 7.2 end)
	end

	if flying and flightVelocity and flightGyro then
		if not (safeModeTriggered and tick() - lastSafeJump < 0.12) then
			local moveDir = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += Camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= Camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= Camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += Camera.CFrame.RightVector end
			if moveDir.Magnitude > 0 then
				moveDir = moveDir.Unit
			end
			flightVelocity.VectorVelocity = moveDir * flySpeed
		end
		flightGyro.CFrame = Camera.CFrame
	end

	if spectating and currentSpectateTarget and currentSpectateTarget.Character then
		local hum2 = currentSpectateTarget.Character:FindFirstChildOfClass("Humanoid")
		if hum2 and Camera.CameraSubject ~= hum2 then
			Camera.CameraSubject = hum2
		end
	end
end)

