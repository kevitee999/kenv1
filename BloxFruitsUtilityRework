local gg = getrawmetatable(game)
local old = gg.__namecall
setreadonly(gg, false)
gg.__namecall = newcclosure(function(...)
	local method = getnamecallmethod()
	local args = { ... }

	if tostring(method) == "FireServer" then
		if soruEnabled and tostring(args[2]) == "Soru" then
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local endCF = getTargetEndCF(hrp)
			if endCF then
				args[4] = endCF
				task.defer(function()
					pcall(function() if hrp then hrp.CFrame = endCF end end)
				end)
				task.delay(0.05, function()
					pcall(function() if hrp and hrp.Parent then hrp.CFrame = endCF end end)
				end)
				return old(unpack(args))
			end
		end

		if tostring(args[1]) == "RemoteEvent" then
			if tostring(args[2]) ~= "true" and tostring(args[2]) ~= "false" then
				if silentAimEnabled and (
					(_G.AimMethod and ABmethod == "Aim Player")
					or (_G.AimMethod and ABmethod == "Nearest Aim")
				) then
					args[2] = MousePos
					return old(unpack(args))
				end
			end
		end
	end

	return old(...)
end)
setreadonly(gg, true)

