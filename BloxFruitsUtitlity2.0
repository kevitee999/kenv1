PingBtn.Font = Enum.Font.GothamBold
PingBtn.Text = "Ping: 0"
PingBtn.Parent = ScreenGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 110, 0, 262)
MainFrame.Position = UDim2.new(0, 20, 0, 52)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderColor3 = Color3.fromRGB(80, 80, 80)
MainFrame.Visible = false
MainFrame.Parent = ScreenGui

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Parent = MainFrame
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 2)

local dragging, dragInput, dragStart, startPos, movedDistance = false, nil, nil, nil, 0
PingBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = PingBtn.Position
		movedDistance = 0
		local c
		c = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				c:Disconnect()
				if movedDistance < 6 then
					MainFrame.Visible = not MainFrame.Visible
				end
			end
		end)
	end
end)
PingBtn.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		movedDistance = delta.Magnitude
		PingBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

task.spawn(function()
	while task.wait(0.5) do
		local pingVal = 0
		local ok, netPing = pcall(function()
			return LocalPlayer:GetNetworkPing()
		end)
		if ok and netPing then
			pingVal = math.round(netPing * 1000)
		else
			pcall(function()
				pingVal = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
			end)
		end
		PingBtn.Text = "Ping: " .. tostring(pingVal)
	end
end)

local function createButton(text, parent)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 18)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btn.BorderColor3 = Color3.fromRGB(60, 60, 60)
	btn.TextColor3 = Color3.fromRGB(200, 200, 200)
	btn.TextSize = 10
	btn.Font = Enum.Font.Code
	btn.Text = text
	btn.Parent = parent
	return btn
end

