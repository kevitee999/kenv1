	InfSoruBtn.Text = "Inf Soru: " .. (infSoru and "ON" or "OFF")
	InfSoruBtn.TextColor3 = infSoru and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(200, 200, 200)
	getInfinity_Soru(infSoru)
end)

