	opt.TextColor3 = Color3.fromRGB(200, 200, 200)
	opt.TextSize = 10
	opt.Font = Enum.Font.Code
	opt.Parent = OptionsFrame

	opt.MouseButton1Click:Connect(function()
		dashMultiplier = mult
		DashDropdownBtn.Text = "Dash Mult: " .. tostring(mult) .. "x v"
		OptionsFrame.Visible = false
		SaveConfig()
	end)
end

DashDropdownBtn.MouseButton1Click:Connect(function()
	OptionsFrame.Visible = not OptionsFrame.Visible
end)

-- ==========================
-- FEATURES
-- ==========================
local function toggleFly()
	flying = not flying
	FlyBtn.Text = "Fly [P]: " .. (flying and "ON" or "OFF")
	FlyBtn.TextColor3 = flying and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(200, 200, 200)

	-- Sync Noclip with Fly state (safe mode overrides in Heartbeat)
	if not safeModeTriggered then
		noclip = flying
	end
	SaveConfig()

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	if flying then
		workspace.Gravity = 0
		if flightAttachment then flightAttachment:Destroy() end
		if flightVelocity then flightVelocity:Destroy() end
		if flightGyro then flightGyro:Destroy() end

		flightAttachment = Instance.new("Attachment", hrp)
		flightVelocity = Instance.new("LinearVelocity", hrp)
		flightVelocity.Attachment0 = flightAttachment
		flightVelocity.MaxForce = math.huge
		flightVelocity.VectorVelocity = Vector3.zero
		flightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World

		flightGyro = Instance.new("AlignOrientation", hrp)
		flightGyro.Attachment0 = flightAttachment
		flightGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
		flightGyro.MaxTorque = math.huge
		flightGyro.Responsiveness = 200
		flightGyro.CFrame = Camera.CFrame
	else
		workspace.Gravity = 196.2
		if flightAttachment then flightAttachment:Destroy() end
		if flightVelocity then flightVelocity:Destroy() end
		if flightGyro then flightGyro:Destroy() end
	end
end

FlyBtn.MouseButton1Click:Connect(toggleFly)
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.P then
		toggleFly()
	end
end)

SpeedBox.FocusLost:Connect(function()
	local num = tonumber(string.match(SpeedBox.Text, "%d+%.?%d*"))
	if num then
		flySpeed = num
		SpeedBox.Text = "Fly Spd: " .. tostring(num)
		SaveConfig()
	else
		SpeedBox.Text = "Fly Spd: " .. tostring(flySpeed)
	end
end)

