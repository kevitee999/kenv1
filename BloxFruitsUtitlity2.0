PingBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
PingBtn.BorderColor3 = Color3.fromRGB(80, 80, 80)
PingBtn.TextColor3 = Color3.fromRGB(80, 255, 120)
